---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Página no encontrada · Edgar Navarro" description="Esta página no existe.">
  <Header />
  <main id="principal" class="wrap missing">
    <h1>Esta página no existe</h1>
    <p>Puede que el enlace esté mal escrito o que la haya movido.</p>
    <a href="/" class="btn btn-primary">Volver al inicio</a>
  </main>
  <Footer />
</Base>

<style>
  .missing {
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 16px;
    padding-block: 96px;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: 800;
  }
  p {
    color: var(--ink-2);
  }
  .btn {
    margin-top: 8px;
  }
</style>
