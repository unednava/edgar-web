---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { mentoring, hasMentoring, mentoringWhatsappLink } from '../data/mentoring';
import { formatUsd } from '../data/shop';
import { site } from '../data/site';

const price = `${formatUsd(mentoring.priceUsd)} USD`;
const description = `${mentoring.intro} ${price} la sesión de ${mentoring.duration}.`;
const waGeneral = mentoringWhatsappLink();

// Datos para buscadores: cada mentoría como un servicio con su precio.
const jsonLd = hasMentoring
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      itemListElement: mentoring.items.map((m, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'Service',
          name: `Mentoría: ${m.title}`,
          description: m.forWho,
          url: new URL(`/mentorias/#${m.id}`, Astro.site).href,
          provider: { '@type': 'Person', name: site.name },
          offers: { '@type': 'Offer', price: mentoring.priceUsd.toFixed(2), priceCurrency: 'USD', url: mentoring.booking },
        },
      })),
    })
  : null;
---

<Base title={`Mentorías · ${site.name}`} description={description} noindex={!hasMentoring}>
  <Header />
  <main id="principal" class="wrap page">
    <header class="intro">
      <img
        class="cutout review"
        src="/collage/mujer-lupa-grafica.webp"
        alt=""
        width="340"
        height="254"
        style="--rot: -5deg"
        decoding="async"
      />
      <h1>{mentoring.title}</h1>
      {
        hasMentoring ? (
          <>
            <p class="lead">{mentoring.intro}</p>
            <p class="meta">
              <strong>{price}</strong> la sesión · {mentoring.duration} · por {mentoring.place}
            </p>
            <p class="pay-note">Pagas en dólares con tarjeta o en bolívares a la tasa del día.</p>
            <div class="intro-actions">
              <a class="btn btn-primary" href="#reservar">
                Reservar una mentoría <Icon name="arrow" size={18} />
              </a>
              {
                waGeneral && (
                  <a class="btn btn-ghost" href={waGeneral} target="_blank" rel="noopener">
                    Consultar por WhatsApp
                  </a>
                )
              }
            </div>
          </>
        ) : (
          <>
            <p class="lead">Estoy preparando las mentorías. Cuando estén listas, las vas a encontrar aquí.</p>
            <a class="btn btn-primary" href="/">
              Volver al inicio
            </a>
          </>
        )
      }
    </header>

    {
      hasMentoring && (
        <>
          <ul class="rows">
            {mentoring.items.map((m) => {
              const waTopic = mentoringWhatsappLink(m.title);
              return (
                <li class="row" id={m.id}>
                  <div class="name">
                    <h2>{m.title}</h2>
                    <div class="row-actions">
                      <a class="book" href="#reservar">
                        Reservar esta mentoría <Icon name="arrow" size={16} />
                      </a>
                      {
                        waTopic && (
                          <a class="ask" href={waTopic} target="_blank" rel="noopener">
                            Preguntar por WhatsApp
                          </a>
                        )
                      }
                    </div>
                  </div>
                  <dl class="qa">
                    <div>
                      <dt>Para quién es</dt>
                      <dd>{m.forWho}</dd>
                    </div>
                    <div>
                      <dt>Qué revisamos</dt>
                      <dd>
                        <ul class="covers">
                          {m.covers.map((c) => (
                            <li>{c}</li>
                          ))}
                        </ul>
                      </dd>
                    </div>
                  </dl>
                </li>
              );
            })}
          </ul>

          <section id="reservar" class="booking" aria-labelledby="reservar-title">
            <h2 id="reservar-title">Elige día y hora</h2>
            <p class="booking-lead">
              Reserva directo aquí sin salir de la web. El pago se coordina después: en dólares con tarjeta o en
              bolívares a la tasa del día.
            </p>
            <div class="calendar-frame">
              <iframe
                src={mentoring.bookingEmbed}
                title="Calendario de reservas de mentorías con Edgar Navarro"
                loading="lazy"
                width="100%"
                height="640"
              />
            </div>
            <p class="booking-fallback">
              ¿Prefieres verlo en pantalla completa?{' '}
              <a href={mentoring.booking} target="_blank" rel="noopener">
                Abrir el calendario en otra pestaña
              </a>
              .
            </p>
          </section>

          <section class="how" aria-labelledby="how-title">
            <h2 id="how-title">Cómo funciona</h2>
            <ol class="steps">
              {mentoring.steps.map((s) => (
                <li>
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                </li>
              ))}
            </ol>
          </section>

          <section class="honest" aria-labelledby="honest-title">
            <h2 id="honest-title">{mentoring.honest.title}</h2>
            <p>{mentoring.honest.text}</p>
            <p class="note">
              ¿Tienes dudas antes de reservar?{' '}
              {
                waGeneral ? (
                  <a href={waGeneral} target="_blank" rel="noopener">
                    Escríbeme por WhatsApp
                  </a>
                ) : (
                  <a href={site.social.linkedin} target="_blank" rel="noopener">
                    Escríbeme en LinkedIn
                  </a>
                )
              }{' '}
              y te respondo.
            </p>
          </section>
        </>
      )
    }
  </main>
  <Footer />
  {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
</Base>

<style>
  .page {
    padding-block: clamp(40px, 7vw, 80px);
  }
  .intro {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    max-width: 680px;
    margin-bottom: clamp(40px, 6vw, 64px);
  }
  .review {
    position: absolute;
    top: -8px;
    left: calc(100% + clamp(24px, 6vw, 96px));
    width: clamp(200px, 24vw, 300px);
  }
  h1 {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    font-weight: 800;
  }
  .meta {
    color: var(--ink-2);
  }
  .meta strong {
    color: var(--ink);
  }
  .pay-note {
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 6px;
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 16px clamp(24px, 5vw, 64px);
    padding: 32px 0;
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 96px;
  }
  .name h2 {
    font-size: clamp(1.375rem, 2.4vw, 1.625rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: 700;
  }
  .row-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    margin-top: 12px;
  }
  .book {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
  }
  .book:hover {
    text-decoration: underline;
  }
  .ask {
    font-size: 0.875rem;
    color: var(--muted);
    text-decoration: underline;
  }
  .ask:hover {
    color: var(--ink);
  }
  .booking {
    margin-top: clamp(48px, 7vw, 72px);
    scroll-margin-top: 96px;
  }
  .booking h2 {
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    font-weight: 700;
  }
  .booking-lead {
    margin-top: 8px;
    max-width: 680px;
    color: var(--ink-2);
  }
  .calendar-frame {
    margin-top: 20px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .calendar-frame iframe {
    display: block;
    width: 100%;
    height: 640px;
    border: 0;
  }
  .booking-fallback {
    margin-top: 12px;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .qa {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px 32px;
  }
  dt {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted);
  }
  dd {
    margin: 4px 0 0;
    color: var(--ink-2);
  }
  .covers {
    margin: 0;
    padding-left: 1.1em;
  }
  .covers li + li {
    margin-top: 6px;
  }

  .how,
  .honest {
    margin-top: clamp(48px, 7vw, 72px);
    max-width: 760px;
  }
  .how h2,
  .honest h2 {
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    font-weight: 700;
  }
  .steps {
    list-style: none;
    counter-reset: step;
    margin: 20px 0 0;
    padding: 0;
  }
  .steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 40px 1fr;
    column-gap: 16px;
    padding: 16px 0;
    border-top: 1px solid var(--line);
  }
  .steps li::before {
    content: counter(step);
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--line);
    font-weight: 700;
    font-size: 0.9375rem;
  }
  .steps h3 {
    font-size: 1.0625rem;
    font-weight: 700;
  }
  .steps p {
    margin-top: 2px;
    color: var(--ink-2);
  }
  .honest p {
    margin-top: 12px;
    color: var(--ink-2);
  }
  .honest .note {
    margin-top: 20px;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  @media (max-width: 1100px) {
    .review {
      position: static;
      align-self: flex-end;
      width: 170px;
      margin-bottom: -8px;
    }
  }
  @media (max-width: 760px) {
    .row,
    .qa {
      grid-template-columns: 1fr;
    }
  }
</style>
