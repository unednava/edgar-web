---
import '../styles/global.css';
import { site, substack } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean; // páginas que no deben aparecer en buscadores (p. ej. la tienda vacía)
}

const { title = site.title, description = site.description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Imagen para redes (1200×630). Se regenera desde scripts/og.html.
const ogImage = new URL('/og.png', Astro.site).href;
const ogImageAlt = 'Edgar Navarro · Marketing con IA que sí funciona.';
// Datos para buscadores: esta web es de una persona (Edgar), no de una empresa.
const personJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: Astro.site?.href,
  jobTitle: 'Especialista en publicidad digital',
  worksFor: { '@type': 'Organization', name: '4Geeks Academy' },
  sameAs: [...Object.values(site.social), substack?.home ?? ''].filter(Boolean),
});
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#f2f2ef" id="theme-color" />
    <script is:inline>
      // Modo claro por defecto. Si la persona eligió el oscuro, se aplica antes de pintar.
      try {
        if (localStorage.getItem('theme') === 'dark') {
          document.documentElement.dataset.theme = 'dark';
          document.getElementById('theme-color').setAttribute('content', '#121212');
        }
      } catch (e) {}
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_419" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={personJsonLd} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
