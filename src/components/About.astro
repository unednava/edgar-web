---
import { about, brands, journey } from '../data/site';
---

<section id="sobre-mi" class="wrap section about">
  <div class="top">
    <div class="text">
      <h2 class="section-title">Sobre mí</h2>
      <p class="lead">{about.lead}</p>
      {about.text.map((t) => <p>{t}</p>)}
    </div>
    <div class="side">
      <img
        class="cutout pen"
        src="/collage/mano-pluma.webp"
        alt=""
        width="342"
        height="330"
        style="--rot: -8deg"
        loading="lazy"
        decoding="async"
      />
      <figure class="motto">
        <figcaption>{about.mottoLabel}</figcaption>
        <blockquote>{about.motto}</blockquote>
      </figure>
    </div>
  </div>

  <ol class="journey" aria-label="Mi recorrido">
    {
      journey.map((step, i) => (
        <li class="step">
          <span class="num" aria-hidden="true">
            {i + 1}
          </span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))
    }
  </ol>

  <div class="brands">
    <h3 class="brands-title">Marcas con las que he trabajado</h3>
    <ul class="logos">
      {
        brands.map((b) => (
          <li
            class:list={['logo', { tinted: b.background, square: b.square }]}
            style={b.background ? `--brand-bg:${b.background}` : undefined}
          >
            <img src={b.logo} alt={b.name} loading="lazy" decoding="async" />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about {
    display: flex;
    flex-direction: column;
    gap: 64px;
    /* Va justo después del inicio, que ya deja aire debajo */
    padding-top: clamp(16px, 3vw, 32px);
  }
  .top {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: end;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 640px;
  }
  .text .lead {
    font-weight: 600;
    color: var(--ink);
  }
  .text p:not(.lead) {
    color: var(--ink-2);
  }
  .side {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  /* Mano con pluma (collage) escribiendo el lema */
  .pen {
    width: 170px;
    align-self: flex-end;
    margin-right: 12%;
  }
  /* El lema: grande y sin caja, con una tira amarilla a la izquierda */
  .motto {
    margin: 0;
    padding-left: 24px;
    border-left: 6px solid var(--hl);
  }
  figcaption {
    font-size: 0.9375rem;
    color: var(--muted);
  }
  blockquote {
    margin: 8px 0 0;
    font-size: clamp(1.5rem, 2.8vw, 2rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: 700;
  }

  /* Recorrido: una línea que une los pasos */
  .journey {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    position: relative;
  }
  .journey::before {
    content: '';
    position: absolute;
    top: 21px;
    left: 22px;
    right: 22px;
    height: 2px;
    background: var(--line);
  }
  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .num {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
    color: var(--accent);
    font-weight: 700;
    margin-bottom: 6px;
  }
  .step:last-child .num {
    background: var(--accent);
    color: var(--on-accent);
  }
  .step h3 {
    font-size: 1.125rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
    font-weight: 700;
  }
  .step p {
    color: var(--ink-2);
    font-size: 1rem;
  }

  .brands-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--muted);
  }
  /* Logos sobre tarjetas blancas en ambos modos: así se ven con sus colores originales */
  .logos {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 12px;
  }
  .logo {
    display: grid;
    place-items: center;
    height: 96px;
    padding: 16px 20px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }
  .logo.tinted {
    background: var(--brand-bg);
    border-color: transparent;
  }
  .logo img {
    display: block;
    max-width: 100%;
    max-height: 44px;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .logo.square img {
    max-height: 64px;
  }

  @media (max-width: 960px) {
    .logos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 880px) {
    .top {
      grid-template-columns: 1fr;
    }
    .pen {
      width: 130px;
    }
    .journey {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .journey::before {
      top: 22px;
      bottom: 22px;
      left: 21px;
      right: auto;
      width: 2px;
      height: auto;
    }
    .step {
      padding-left: 64px;
    }
    .num {
      position: absolute;
      left: 0;
      top: 0;
    }
  }
  @media (max-width: 480px) {
    .logos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .logo {
      height: 84px;
    }
  }
</style>
