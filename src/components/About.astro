---
import { brands, journey } from '../data/site';
---

<section id="sobre-mi" class="wrap section about">
  <div class="section-head">
    <p class="kicker">Sobre mí</p>
    <h2 class="section-title">Cómo llegué hasta aquí.</h2>
    <p class="lead">Hago campañas de publicidad de día y automatizaciones de noche.</p>
  </div>

  <ol class="journey">
    {
      journey.map((step, i) => (
        <li class="step">
          <span class="num" aria-hidden="true">
            {i + 1}
          </span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))
    }
  </ol>

  <div class="brands">
    <p class="brands-title">Marcas con las que he trabajado</p>
    <ul class="logos">
      {
        brands.map((b) => (
          <li class:list={['logo', { tinted: b.background, square: b.square }]} style={b.background ? `--brand-bg:${b.background}` : undefined}>
            <img src={b.logo} alt={b.name} loading="lazy" decoding="async" />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about {
    display: flex;
    flex-direction: column;
    /* Va justo después del saludo: menos aire arriba para que se lean juntos */
    padding-top: clamp(40px, 6vw, 64px);
  }
  /* Recorrido: una línea que une los pasos */
  .journey {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    position: relative;
  }
  .journey::before {
    content: '';
    position: absolute;
    top: 21px;
    left: 22px;
    right: 22px;
    height: 2px;
    background: var(--line);
  }
  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .num {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--surface);
    border: 2px solid var(--accent);
    color: var(--accent);
    font-weight: 700;
    margin-bottom: 6px;
  }
  .step:last-child .num {
    background: var(--accent);
    color: var(--on-accent);
  }
  h3 {
    font-size: 1.125rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
    font-weight: 700;
  }
  .step p {
    color: var(--ink-2);
    font-size: 1rem;
  }
  .brands {
    margin-top: 64px;
  }
  .brands-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--muted);
    text-align: center;
  }
  /* Logos sobre tarjetas blancas en ambos modos: así se ven con sus colores originales */
  .logos {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 12px;
  }
  .logo {
    display: grid;
    place-items: center;
    height: 96px;
    padding: 16px 20px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow);
    transition:
      transform 240ms var(--ease-out),
      box-shadow 240ms var(--ease-out);
  }
  .logo:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }
  .logo.tinted {
    background: var(--brand-bg);
    border-color: transparent;
  }
  .logo img {
    display: block;
    max-width: 100%;
    max-height: 44px;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .logo.square img {
    max-height: 64px;
  }
  @media (max-width: 960px) {
    .logos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 480px) {
    .logos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .logo {
      height: 84px;
    }
  }
  @media (max-width: 880px) {
    .journey {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .journey::before {
      top: 22px;
      bottom: 22px;
      left: 21px;
      right: auto;
      width: 2px;
      height: auto;
    }
    .step {
      padding-left: 64px;
    }
    .num {
      position: absolute;
      left: 0;
      top: 0;
    }
  }
</style>
