---
import { topics } from '../data/site';
---

<section id="aprende" class="wrap section topics">
  <h2 class="section-title">De qué hablo en los videos</h2>

  <ul class="rows">
    {
      topics.map((t) => (
        <li class="row" id={t.id}>
          <div class="name">
            <h3>{t.title}</h3>
            <p class="tools">{t.tools}</p>
          </div>
          <dl class="qa">
            <div>
              <dt>Lo que vas a entender</dt>
              <dd>{t.what}</dd>
            </div>
            <div>
              <dt>Lo que te llevas</dt>
              <dd>{t.how}</dd>
            </div>
          </dl>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .topics .section-title {
    margin-bottom: 32px;
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 16px clamp(24px, 5vw, 64px);
    padding: 32px 0;
    border-bottom: 1px solid var(--line);
  }
  h3 {
    font-size: clamp(1.375rem, 2.4vw, 1.625rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: 700;
  }
  .tools {
    margin-top: 8px;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .qa {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px 32px;
  }
  dt {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted);
  }
  dd {
    margin: 4px 0 0;
    color: var(--ink-2);
  }
  @media (max-width: 760px) {
    .row,
    .qa {
      grid-template-columns: 1fr;
    }
  }
</style>
