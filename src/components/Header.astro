---
import { site, primaryCta as cta, substack } from '../data/site';
import { latestPosts } from '../data/blog';
import { hasShop } from '../data/shop';
import Icon from './Icon.astro';
---

<a href="#principal" class="skip-link">Saltar al contenido</a>

<header class="header" id="site-header">
  <nav class="wrap nav" aria-label="Principal">
    <a href="/" class="brand">
      <img class="mark" src="/brand/llama.webp" alt="" width="34" height="40" />
      <span class="brand-name">{site.name}</span>
    </a>
    <div class="links" id="site-menu">
      <a href="/#sobre-mi">Sobre mí</a>
      <a href="/#aprende">De qué hablo</a>
      <a href="/#videos">Videos</a>
      {hasShop && <a href="/recursos">Recursos</a>}
      {
        substack && latestPosts.length > 0 && (
          <a href={substack.home} target="_blank" rel="noopener">
            Blog
          </a>
        )
      }
      <a
        href={cta.href}
        class="menu-cta btn btn-primary"
        {...cta.external ? { target: '_blank', rel: 'noopener' } : {}}
      >
        {cta.label}
      </a>
    </div>
    <button type="button" class="theme" id="theme-toggle" aria-label="Activar modo oscuro">
      <span class="i-moon"><Icon name="moon" size={20} /></span>
      <span class="i-sun"><Icon name="sun" size={20} /></span>
    </button>
    <a
      href={cta.href}
      class="btn btn-primary cta"
      aria-label={cta.label}
      {...cta.external ? { target: '_blank', rel: 'noopener' } : {}}
    >
      {cta.short}
    </a>
    <button
      type="button"
      class="menu-btn"
      id="menu-toggle"
      aria-label="Abrir el menú"
      aria-expanded="false"
      aria-controls="site-menu"
    >
      <span class="i-open"><Icon name="menu" size={22} /></span>
      <span class="i-close"><Icon name="close" size={22} /></span>
    </button>
  </nav>
</header>

<style>
  /* Barra translúcida: el contenido pasa por debajo sin perder legibilidad */
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--header-bg);
    backdrop-filter: blur(18px) saturate(180%);
    -webkit-backdrop-filter: blur(18px) saturate(180%);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 16px 32px;
    min-height: 72px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
    font-weight: 800;
    font-size: 1.125rem;
    letter-spacing: -0.02em;
    white-space: nowrap;
    margin-right: auto;
  }
  /* Logo: llama con flecha + nombre en texto (se adapta solo al modo oscuro) */
  .mark {
    flex: none;
    display: block;
    width: 34px;
    height: 40px;
  }
  .links {
    display: flex;
    gap: 28px;
  }
  .links a {
    color: var(--ink-2);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .links a:hover {
    color: var(--ink);
  }
  .cta {
    min-height: 44px;
    padding: 0 20px;
    font-size: 0.9375rem;
  }
  .theme {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink-2);
    cursor: pointer;
    transition:
      transform 160ms var(--ease-out),
      color 200ms ease;
  }
  .theme:hover {
    color: var(--ink);
  }
  .theme:active {
    transform: scale(0.92);
    transition-duration: 80ms;
  }
  .i-moon,
  .i-sun {
    display: grid;
  }
  .i-sun,
  :global([data-theme='dark']) .i-moon {
    display: none;
  }
  :global([data-theme='dark']) .i-sun {
    display: grid;
  }
  .menu-btn,
  .menu-cta {
    display: none;
  }
  .menu-btn {
    flex: none;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }
  .menu-btn:active {
    transform: scale(0.92);
  }
  .i-open,
  .i-close {
    display: grid;
  }
  .i-close,
  .menu-btn[aria-expanded='true'] .i-open {
    display: none;
  }
  .menu-btn[aria-expanded='true'] .i-close {
    display: grid;
  }
  /* En móvil los enlaces pasan a un menú desplegable bajo la barra */
  @media (max-width: 760px) {
    .menu-btn {
      display: grid;
    }
    .links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      padding: 8px 24px 20px;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 24px 40px -24px rgba(20, 20, 20, 0.25);
    }
    .links.open {
      display: flex;
    }
    .links a:not(.menu-cta) {
      display: flex;
      align-items: center;
      min-height: 52px;
      font-size: 1.0625rem;
      border-bottom: 1px solid var(--line);
    }
    .links a.menu-cta {
      display: none;
      margin-top: 16px;
      color: var(--on-accent);
    }
  }
  @media (max-width: 560px) {
    .cta {
      display: none;
    }
    .links a.menu-cta {
      display: inline-flex;
    }
  }
  @media (max-width: 480px) {
    .nav {
      gap: 10px;
      padding-inline: 16px;
    }
    .brand {
      font-size: 1rem;
      gap: 8px;
    }
    .cta {
      padding: 0 16px;
      font-size: 0.875rem;
    }
  }
  /* En pantallas muy estrechas queda solo el monograma; el nombre sigue para lectores de pantalla */
  @media (max-width: 359px) {
    .brand-name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }
  @media (prefers-reduced-transparency: reduce) {
    .header {
      background: var(--bg);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
</style>

<script>
  // Menú desplegable (móvil): se abre con ☰, se cierra con Escape, al tocar fuera o al elegir un enlace
  const menu = document.getElementById('site-menu');
  const menuBtn = document.getElementById('menu-toggle');
  const siteHeader = document.getElementById('site-header');

  function setMenu(open: boolean) {
    menu?.classList.toggle('open', open);
    menuBtn?.setAttribute('aria-expanded', String(open));
    menuBtn?.setAttribute('aria-label', open ? 'Cerrar el menú' : 'Abrir el menú');
  }

  menuBtn?.addEventListener('click', () => setMenu(menuBtn.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setMenu(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menuBtn?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      menuBtn.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (siteHeader && !siteHeader.contains(e.target as Node)) setMenu(false);
  });
  window.matchMedia('(min-width: 761px)').addEventListener('change', (e) => {
    if (e.matches) setMenu(false);
  });

  const root = document.documentElement;
  const button = document.getElementById('theme-toggle');
  const meta = document.getElementById('theme-color');

  function sync() {
    const dark = root.dataset.theme === 'dark';
    button?.setAttribute('aria-label', dark ? 'Activar modo claro' : 'Activar modo oscuro');
    meta?.setAttribute('content', dark ? '#121212' : '#f2f2ef');
  }

  button?.addEventListener('click', () => {
    const dark = root.dataset.theme !== 'dark';
    if (dark) root.dataset.theme = 'dark';
    else delete root.dataset.theme;
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch (e) {}
    sync();
  });

  sync();
</script>
