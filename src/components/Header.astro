---
import { site } from '../data/site';
---

<a href="#principal" class="skip-link">Saltar al contenido</a>

<header class="header">
  <nav class="wrap nav" aria-label="Principal">
    <a href="/" class="brand">
      <span class="mark" aria-hidden="true">EN</span>
      {site.name}
    </a>
    <div class="links">
      <a href="#aprende">Qué aprendes</a>
      <a href="#plantillas">Plantillas</a>
      <a href="#sobre-mi">Sobre mí</a>
    </div>
    <a href="#newsletter" class="btn btn-primary cta">Suscribirme</a>
  </nav>
</header>

<style>
  /* Barra translúcida: el contenido pasa por debajo sin perder legibilidad */
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--header-bg);
    backdrop-filter: blur(18px) saturate(180%);
    -webkit-backdrop-filter: blur(18px) saturate(180%);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 16px 32px;
    min-height: 72px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    margin-right: auto;
  }
  .mark {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 11px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .links {
    display: flex;
    gap: 28px;
  }
  .links a {
    color: var(--ink-2);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .links a:hover {
    color: var(--ink);
  }
  .cta {
    min-height: 44px;
    padding: 0 20px;
    font-size: 0.9375rem;
  }
  @media (max-width: 760px) {
    .links {
      display: none;
    }
  }
  @media (prefers-reduced-transparency: reduce) {
    .header {
      background: var(--bg);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
</style>
