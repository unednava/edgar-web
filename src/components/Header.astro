---
import { site, primaryCta as cta, substack } from '../data/site';
import { hasShop } from '../data/shop';
import Icon from './Icon.astro';
---

<a href="#principal" class="skip-link">Saltar al contenido</a>

<header class="header">
  <nav class="wrap nav" aria-label="Principal">
    <a href="/" class="brand">
      <img class="mark" src="/edgar/cara.webp" alt="" width="36" height="36" />
      <span class="brand-name">{site.name}</span>
    </a>
    <div class="links">
      <a href="/#sobre-mi">Sobre mí</a>
      <a href="/#aprende">De qué hablo</a>
      <a href="/#videos">Videos</a>
      {hasShop && <a href="/recursos">Recursos</a>}
      {
        substack && (
          <a href={substack.home} target="_blank" rel="noopener">
            Blog
          </a>
        )
      }
    </div>
    <button type="button" class="theme" id="theme-toggle" aria-label="Activar modo oscuro">
      <span class="i-moon"><Icon name="moon" size={20} /></span>
      <span class="i-sun"><Icon name="sun" size={20} /></span>
    </button>
    <a
      href={cta.href}
      class="btn btn-primary cta"
      aria-label={cta.label}
      {...cta.external ? { target: '_blank', rel: 'noopener' } : {}}
    >
      {cta.short}
    </a>
  </nav>
</header>

<style>
  /* Barra translúcida: el contenido pasa por debajo sin perder legibilidad */
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--header-bg);
    backdrop-filter: blur(18px) saturate(180%);
    -webkit-backdrop-filter: blur(18px) saturate(180%);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 16px 32px;
    min-height: 72px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
    margin-right: auto;
  }
  .mark {
    flex: none;
    display: block;
    width: 36px;
    height: 36px;
    border-radius: 50%;
  }
  .links {
    display: flex;
    gap: 28px;
  }
  .links a {
    color: var(--ink-2);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .links a:hover {
    color: var(--ink);
  }
  .cta {
    min-height: 44px;
    padding: 0 20px;
    font-size: 0.9375rem;
  }
  .theme {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink-2);
    cursor: pointer;
    transition:
      transform 160ms var(--ease-out),
      color 200ms ease;
  }
  .theme:hover {
    color: var(--ink);
  }
  .theme:active {
    transform: scale(0.92);
    transition-duration: 80ms;
  }
  .i-moon,
  .i-sun {
    display: grid;
  }
  .i-sun,
  :global([data-theme='dark']) .i-moon {
    display: none;
  }
  :global([data-theme='dark']) .i-sun {
    display: grid;
  }
  @media (max-width: 760px) {
    .links {
      display: none;
    }
  }
  @media (max-width: 480px) {
    .nav {
      gap: 10px;
      padding-inline: 16px;
    }
    .brand {
      font-size: 1rem;
      gap: 8px;
    }
    .cta {
      padding: 0 16px;
      font-size: 0.875rem;
    }
  }
  /* En pantallas muy estrechas queda solo el monograma; el nombre sigue para lectores de pantalla */
  @media (max-width: 359px) {
    .brand-name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }
  @media (prefers-reduced-transparency: reduce) {
    .header {
      background: var(--bg);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const button = document.getElementById('theme-toggle');
  const meta = document.getElementById('theme-color');

  function sync() {
    const dark = root.dataset.theme === 'dark';
    button?.setAttribute('aria-label', dark ? 'Activar modo claro' : 'Activar modo oscuro');
    meta?.setAttribute('content', dark ? '#0b111c' : '#f6f7f9');
  }

  button?.addEventListener('click', () => {
    const dark = root.dataset.theme !== 'dark';
    if (dark) root.dataset.theme = 'dark';
    else delete root.dataset.theme;
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch (e) {}
    sync();
  });

  sync();
</script>
