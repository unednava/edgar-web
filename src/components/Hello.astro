---
import { hello } from '../data/site';
---

<section class="wrap hello" aria-labelledby="hola">
  <div class="card box">
    <!-- Cuando tengas una foto, cámbiala aquí por <img src="/edgar.jpg" alt="Edgar Navarro" />. -->
    <div class="avatar" aria-hidden="true">EN</div>
    <div class="text">
      <h2 id="hola">{hello.title}</h2>
      {hello.text.map((t) => <p>{t}</p>)}
    </div>
    <figure class="motto">
      <figcaption>{hello.mottoLabel}</figcaption>
      <blockquote>{hello.motto}</blockquote>
    </figure>
  </div>
</section>

<style>
  .hello {
    padding-bottom: 32px;
  }
  .box {
    display: grid;
    grid-template-columns: auto 1fr minmax(0, 0.9fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
    padding: clamp(28px, 4vw, 44px);
  }
  .avatar {
    display: grid;
    place-items: center;
    width: clamp(80px, 9vw, 112px);
    aspect-ratio: 1;
    border-radius: 32%;
    background:
      radial-gradient(120% 120% at 25% 15%, color-mix(in srgb, var(--accent) 35%, transparent), transparent 60%),
      var(--accent-soft);
    color: var(--accent);
    font-size: clamp(1.5rem, 2.6vw, 2.125rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    align-self: start;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  h2 {
    font-size: clamp(1.625rem, 3vw, 2.125rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
    font-weight: 800;
  }
  .text p {
    color: var(--ink-2);
    font-size: 1.0625rem;
  }
  .motto {
    margin: 0;
    padding: 24px 26px;
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    border-left: 4px solid var(--accent);
  }
  figcaption {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent);
  }
  blockquote {
    margin: 8px 0 0;
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
    line-height: 1.3;
    letter-spacing: -0.015em;
    font-weight: 700;
    color: var(--ink);
  }
  @media (max-width: 960px) {
    .box {
      grid-template-columns: auto 1fr;
    }
    .motto {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 560px) {
    .box {
      grid-template-columns: 1fr;
    }
  }
</style>
