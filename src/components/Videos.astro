---
import { site } from '../data/site';
import { videos, upcoming } from '../data/videos';

const hasVideos = videos.length > 0;
const latest = videos.slice(0, 3);
---

<section class="wrap section videos">
  <div class="head">
    <h2 class="section-title">{hasVideos ? 'Últimos videos' : 'Próximos videos'}</h2>
    {site.social.youtube && <a href={site.social.youtube}>Ver el canal en YouTube →</a>}
  </div>

  <div class="grid">
    {
      hasVideos
        ? latest.map((v) => (
            <a class="card" href={`https://www.youtube.com/watch?v=${v.youtubeId}`}>
              <img
                src={`https://i.ytimg.com/vi/${v.youtubeId}/hqdefault.jpg`}
                alt=""
                width="480"
                height="270"
                loading="lazy"
              />
              <div class="body">
                <span class="meta mono">
                  ● {v.track} · {v.minutes} min
                </span>
                <span class="title">{v.title}</span>
              </div>
            </a>
          ))
        : upcoming.map((v) => (
            <div class="card">
              <div class="thumb mono">próximamente</div>
              <div class="body">
                <span class="meta mono">● {v.track} · 7 min</span>
                <span class="title">{v.title}</span>
              </div>
            </div>
          ))
    }
  </div>
</section>

<style>
  .videos {
    padding-top: 24px;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
    margin-bottom: 28px;
  }
  .head a {
    text-decoration: none;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }
  .card {
    display: flex;
    flex-direction: column;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    color: var(--text);
    text-decoration: none;
  }
  a.card:hover {
    border-color: #33405a;
    color: var(--text);
  }
  img,
  .thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }
  .thumb {
    background: #18233a;
    display: grid;
    place-items: center;
    color: var(--muted);
    font-size: 13px;
  }
  .body {
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .meta {
    font-size: 13px;
    color: var(--accent);
  }
  .title {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.35;
  }
</style>
