---
import { site, extras } from '../data/site';
import { videos, upcoming } from '../data/videos';
import Icon from './Icon.astro';

const hasVideos = videos.length > 0;
const latest = videos.slice(0, 3);
---

<section id="videos" class="wrap section videos" aria-labelledby="videos-title">
  <div class="head">
    <h2 class="section-title" id="videos-title">{hasVideos ? 'Últimos videos' : 'Los primeros videos'}</h2>
    {
      site.social.youtube && (
        <a class="channel" href={site.social.youtube}>
          Ver el canal en YouTube <Icon name="arrow" size={18} />
        </a>
      )
    }
  </div>

  {
    hasVideos ? (
      <div class="grid">
        {latest.map((v) => (
          <a class="video" href={`https://www.youtube.com/watch?v=${v.youtubeId}`}>
            <img
              src={`https://i.ytimg.com/vi/${v.youtubeId}/hqdefault.jpg`}
              alt=""
              width="480"
              height="270"
              loading="lazy"
            />
            <span class="meta">
              {v.topic} · {v.minutes} min
            </span>
            <span class="title">{v.title}</span>
          </a>
        ))}
      </div>
    ) : (
      <>
        <p class="lead">Estos son los temas con los que arranco. Cada video dura unos 7 minutos.</p>
        <ol class="upcoming">
          {upcoming.map((v) => (
            <li>
              <span class="title">{v.title}</span>
              <span class="topic">{v.topic}</span>
            </li>
          ))}
        </ol>
      </>
    )
  }

  <div id="plantillas" class="extras">
    <h3>{extras.title}</h3>
    <p>{extras.text}</p>
    <ul>
      {
        extras.items.map((item) => (
          <li>
            <span class="check" aria-hidden="true">
              <Icon name="check" size={18} />
            </span>
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 24px;
    margin-bottom: 16px;
  }
  .channel {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    text-decoration: none;
  }
  .lead {
    max-width: 640px;
  }

  /* Próximos videos: lista sencilla, sin miniaturas de relleno */
  .upcoming {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    counter-reset: v;
    border-top: 1px solid var(--line);
  }
  .upcoming li {
    counter-increment: v;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    gap: 4px 16px;
    align-items: baseline;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }
  .upcoming li::before {
    content: counter(v);
    font-weight: 700;
    color: var(--muted);
  }
  .upcoming .title {
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .topic {
    font-size: 0.875rem;
    color: var(--muted);
  }

  /* Videos publicados: miniaturas reales de YouTube */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    margin-top: 24px;
  }
  .video {
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: var(--ink);
    text-decoration: none;
  }
  .video img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-sm);
    margin-bottom: 6px;
  }
  .video:hover .title {
    text-decoration: underline;
  }
  .meta {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent);
  }
  .video .title {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.4;
  }

  /* Lo que acompaña a cada video */
  .extras {
    margin-top: 56px;
    padding: clamp(24px, 4vw, 40px);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .extras h3 {
    font-size: 1.375rem;
    letter-spacing: -0.015em;
    font-weight: 700;
  }
  .extras p {
    margin-top: 8px;
    color: var(--ink-2);
  }
  .extras ul {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px 32px;
  }
  .extras li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .check {
    flex: none;
    color: var(--accent);
    margin-top: 4px;
  }
  @media (max-width: 760px) {
    .extras ul {
      grid-template-columns: 1fr;
    }
    .upcoming li {
      grid-template-columns: 2rem minmax(0, 1fr);
    }
    .topic {
      grid-column: 2;
    }
  }
</style>
