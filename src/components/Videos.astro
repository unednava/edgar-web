---
import { site } from '../data/site';
import { videos, upcoming } from '../data/videos';
import Icon from './Icon.astro';

const hasVideos = videos.length > 0;
const latest = videos.slice(0, 3);
---

<section class="wrap section videos" aria-labelledby="videos-title">
  <div class="head">
    <div class="section-head">
      <p class="kicker">{hasVideos ? 'Lo más reciente' : 'Muy pronto'}</p>
      <h2 class="section-title" id="videos-title">{hasVideos ? 'Últimos videos' : 'Los primeros videos'}</h2>
    </div>
    {
      site.social.youtube && (
        <a class="channel" href={site.social.youtube}>
          Ver el canal en YouTube <Icon name="arrow" size={18} />
        </a>
      )
    }
  </div>

  <div class="grid">
    {
      hasVideos
        ? latest.map((v) => (
            <a class="video card" href={`https://www.youtube.com/watch?v=${v.youtubeId}`}>
              <img
                src={`https://i.ytimg.com/vi/${v.youtubeId}/hqdefault.jpg`}
                alt=""
                width="480"
                height="270"
                loading="lazy"
              />
              <span class="body">
                <span class="meta">
                  {v.topic} · {v.minutes} min
                </span>
                <span class="title">{v.title}</span>
              </span>
            </a>
          ))
        : upcoming.map((v) => (
            <article class="video card">
              <div class="thumb" aria-hidden="true">
                <span class="play">
                  <Icon name="play" size={22} />
                </span>
              </div>
              <div class="body">
                <p class="meta">{v.topic} · Próximamente</p>
                <h3 class="title">{v.title}</h3>
              </div>
            </article>
          ))
    }
  </div>
</section>

<style>
  .videos {
    padding-top: 0;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 0 24px;
  }
  .channel {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    text-decoration: none;
    margin-bottom: 40px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }
  .video {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    color: var(--ink);
    text-decoration: none;
    transition:
      transform 240ms var(--ease-out),
      box-shadow 240ms var(--ease-out);
  }
  a.video:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    color: var(--ink);
  }
  img,
  .thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }
  .thumb {
    display: grid;
    place-items: center;
    background:
      radial-gradient(120% 90% at 20% 10%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 60%),
      var(--accent-soft);
  }
  .play {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--surface);
    color: var(--accent);
    box-shadow: var(--shadow);
    padding-left: 3px;
  }
  .body {
    padding: 20px 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .meta {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent);
  }
  .title {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }
</style>
