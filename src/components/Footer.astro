---
import { site } from '../data/site';

const links = [
  { label: 'YouTube', href: site.social.youtube },
  { label: 'LinkedIn', href: site.social.linkedin },
  { label: 'Instagram', href: site.social.instagram },
  { label: 'TikTok', href: site.social.tiktok },
].filter((l) => l.href);

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap row">
    <span>© {year} {site.name} · Marketing con IA, con datos</span>
    <nav class="links" aria-label="Redes">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <span class="mono status">estado: <span class="dot"></span> todo en producción</span>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-deep);
    border-top: 1px solid var(--line-soft);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    justify-content: space-between;
    align-items: center;
    padding-block: 32px;
    font-size: 14px;
    color: var(--muted);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }
  .links a {
    text-decoration: none;
  }
  .status {
    font-size: 13px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
</style>
