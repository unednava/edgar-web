---
import { site, substack } from '../data/site';
import { latestPosts } from '../data/blog';

// "Blog" solo aparece cuando hay al menos un artículo: nadie llega a un blog vacío.
const links = [
  { label: 'Blog', href: substack && latestPosts.length > 0 ? substack.home : '' },
  { label: 'YouTube', href: site.social.youtube },
  { label: 'LinkedIn', href: site.social.linkedin },
  { label: 'Instagram', href: site.social.instagram },
  { label: 'TikTok', href: site.social.tiktok },
].filter((l) => l.href);

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap row">
    <div class="sign">
      <p class="brand"><img src="/brand/llama.webp" alt="" width="24" height="28" loading="lazy" />{site.name}</p>
      <p class="motto">{site.motto}</p>
      <p class="copy">© {year}</p>
    </div>
    <nav class="links" aria-label="Blog y redes">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    justify-content: space-between;
    align-items: center;
    padding-block: 32px 40px;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .sign {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .brand img {
    display: block;
    width: 24px;
    height: 28px;
  }
  .motto {
    color: var(--ink-2);
    text-wrap: balance;
  }
  .copy {
    font-size: 0.875rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }
  .links a {
    font-weight: 600;
    text-decoration: none;
  }
  .links a:hover {
    text-decoration: underline;
  }
</style>
