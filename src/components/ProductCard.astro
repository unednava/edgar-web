---
// Tarjeta de producto en la tienda y en el adelanto de la página principal.
// Toda la tarjeta lleva a la página del producto (/recursos/<id>/), donde están los botones de compra.
import type { Product } from '../data/shop';
import { formatUsd, productUrl } from '../data/shop';
import Icon from './Icon.astro';

interface Props {
  product: Product;
  headingLevel?: 'h2' | 'h3';
}

const { product: p, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const free = p.priceUsd === 0;
const href = productUrl(p);
---

<article class="product">
  <div class="cover">
    {
      p.cover ? (
        <img src={p.cover} alt="" width="1280" height="720" loading="lazy" decoding="async" />
      ) : (
        // Sin imagen: el nombre va en la portada y no se repite debajo.
        <div class="cover-text">
          <p class="cover-format">{p.format}</p>
          <Heading class="cover-title">
            <a href={href}>{p.title}</a>
          </Heading>
        </div>
      )
    }
  </div>

  <div class="body">
    {
      p.cover && (
        <>
          <p class="format">{p.format}</p>
          <Heading class="title">
            <a href={href}>{p.title}</a>
          </Heading>
        </>
      )
    }
    <p class="desc">{p.description}</p>

    <div class="foot">
      <p class="price">
        <span class="amount">{formatUsd(p.priceUsd)}</span>
        {!free && <span class="currency">USD</span>}
      </p>
      <span class="more" aria-hidden="true">
        Ver recurso <Icon name="arrow" size={16} />
      </span>
    </div>
  </div>
</article>

<style>
  .product {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      transform 200ms var(--ease-out),
      border-color 200ms ease;
  }
  .product:hover {
    transform: translateY(-2px);
    border-color: var(--field-border);
  }
  .cover {
    aspect-ratio: 16 / 9;
    background: var(--accent-soft);
    border-bottom: 1px solid var(--line);
  }
  .cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Sin imagen: portada tipográfica con el nombre del recurso */
  .cover-text {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(18px, 3vw, 26px);
  }
  .cover-format {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--muted);
  }
  .cover-title {
    font-size: clamp(1.375rem, 2.6vw, 1.75rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    font-weight: 800;
    color: var(--ink);
    max-width: 14ch;
  }
  .body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 22px 22px;
  }
  .format {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .title {
    font-size: 1.25rem;
    line-height: 1.25;
    letter-spacing: -0.015em;
    font-weight: 700;
  }
  .title a,
  .cover-title a {
    color: var(--ink);
    text-decoration: none;
  }
  /* Toda la tarjeta es clicable */
  .title a::after,
  .cover-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }
  .title a:focus-visible,
  .cover-title a:focus-visible {
    outline: none;
  }
  .title a:focus-visible::after,
  .cover-title a:focus-visible::after {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }
  .desc {
    color: var(--ink-2);
    font-size: 1rem;
  }
  .foot {
    margin-top: auto;
    padding-top: 14px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .price {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .amount {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .currency {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--muted);
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .product:hover .more {
    text-decoration: underline;
    text-decoration-color: var(--hl);
    text-decoration-thickness: 3px;
    text-underline-offset: 4px;
  }
</style>
