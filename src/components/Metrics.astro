---
import { metrics } from '../data/site';
---

<section class="wrap" aria-label="Experiencia en números">
  <dl class="grid card">
    {
      metrics.map((m) => (
        <div class="item">
          <dt class="sr-only">{m.label}</dt>
          <dd class:list={['value', { hl: m.highlight }]}>{m.value}</dd>
          <dd class="label" aria-hidden="true">{m.label}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    padding: 8px;
  }
  .item {
    padding: 24px 24px 22px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .item + .item {
    border-left: 1px solid var(--line);
  }
  dd {
    margin: 0;
  }
  .value {
    font-size: clamp(1.875rem, 3.4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .hl {
    color: var(--accent);
  }
  .label {
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--ink-2);
  }
  @media (max-width: 880px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .item:nth-child(3) {
      border-left: 0;
    }
    .item:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }
</style>
