---
import { templates as t } from '../data/site';
import Icon from './Icon.astro';
---

<section id="plantillas" class="section band">
  <div class="wrap split">
    <div class="copy">
      <p class="kicker">Empieza gratis · Plantillas</p>
      <h2 class="section-title">{t.title}</h2>
      <p class="lead">{t.text}</p>
      <a href="#newsletter" class="btn btn-primary">Quiero las plantillas</a>
    </div>

    <ul class="list card" aria-label="Qué incluye cada plantilla">
      {
        t.included.map((f) => (
          <li>
            <span class="icon">
              <Icon name={f.icon} size={22} />
            </span>
            <span>
              <strong>{f.title}</strong>
              <span class="desc">{f.description}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .band {
    background: var(--surface);
    border-block: 1px solid var(--line);
  }
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 6vw, 72px);
    align-items: center;
  }
  .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }
  .copy .btn {
    margin-top: 8px;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 8px 0;
    background: var(--bg);
    box-shadow: none;
  }
  li {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 20px 24px;
  }
  li + li {
    border-top: 1px solid var(--line);
  }
  .icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  strong {
    display: block;
    font-weight: 600;
    font-size: 1.0625rem;
  }
  .desc {
    color: var(--ink-2);
    font-size: 1rem;
  }
  @media (max-width: 880px) {
    .split {
      grid-template-columns: 1fr;
    }
  }
</style>
