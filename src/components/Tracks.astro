---
import { tracks } from '../data/site';
---

<section id="contenido" class="wrap section">
  <div class="head">
    <p class="eyebrow">campañas activas</p>
    <h2 class="section-title">Tres caminos, un mismo objetivo: resultados medibles.</h2>
  </div>

  <div class="table-box" role="region" aria-label="Campañas activas" tabindex="0">
    <table>
      <thead class="mono">
        <tr>
          <th scope="col">Campaña</th>
          <th scope="col">Estado</th>
          <th scope="col">Qué aprendes</th>
          <th scope="col">Herramientas</th>
        </tr>
      </thead>
      <tbody>
        {
          tracks.map((t) => (
            <tr id={t.id}>
              <td class="name"><span aria-hidden="true">● </span>{t.name}</td>
              <td class="status mono">activa</td>
              <td class="desc">{t.description}</td>
              <td class="tools">{t.tools.join(' · ')}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<style>
  .head {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 28px;
  }
  .table-box {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 14px;
  }
  table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    font-size: 16px;
  }
  thead tr {
    background: var(--panel);
    text-align: left;
    font-size: 13px;
    color: var(--muted);
  }
  th {
    padding: 14px 20px;
    font-weight: 500;
  }
  td {
    padding: 20px;
    border-top: 1px solid var(--line);
    vertical-align: top;
  }
  .name {
    font-weight: 600;
    white-space: nowrap;
  }
  .status {
    color: var(--accent);
    font-size: 14px;
  }
  .desc {
    color: var(--text-2);
  }
  .tools {
    color: var(--muted);
  }
</style>
