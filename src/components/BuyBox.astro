---
// Bloque de compra de la página de un producto: precio en dólares, botón a Gumroad y,
// si hay número de WhatsApp, opción de pagar en bolívares.
import type { Product } from '../data/shop';
import { formatUsd, whatsappLink } from '../data/shop';

interface Props {
  product: Product;
}

const { product: p } = Astro.props;
const free = p.priceUsd === 0;
const wa = whatsappLink(p);
---

<div class="buy">
  <p class="price">
    <span class="amount">{formatUsd(p.priceUsd)}</span>
    {!free && <span class="currency">USD</span>}
  </p>
  <div class="actions">
    {
      // Sin añadir nada al enlace: gumroad.js le pone ?overlay=true y abre el pago encima de la web.
      // Con ?wanted=true, Gumroad se salta el modal y saca al visitante de la página.
    }
    <a class="btn btn-primary" href={p.gumroad} rel="noopener">
      {free ? 'Descargar gratis' : 'Comprar en dólares'}
    </a>
    {
      wa && (
        <button type="button" class="btn btn-ghost" data-bs-toggle aria-expanded="false" aria-controls="bs-panel">
          Pagar en bolívares
        </button>
      )
    }
  </div>
  {
    wa && (
      <div class="bs-panel" id="bs-panel" hidden>
        <p class="bs-title">Pago en bolívares · {formatUsd(p.priceUsd)} USD a la tasa del día</p>
        <p class="bs-text">
          Escríbeme por WhatsApp con el mensaje ya listo. Te paso el monto a la tasa del día y los datos de pago; al
          confirmarlo, te envío el recurso.
        </p>
        <a class="btn btn-primary bs-wa" href={wa} target="_blank" rel="noopener">
          Abrir WhatsApp con mensaje listo
        </a>
      </div>
    )
  }
  <p class="note">
    {
      free
        ? 'La descarga se abre aquí mismo sin salir de la web: dejas tu correo y te llega al momento.'
        : wa
          ? 'En dólares, el pago con tarjeta se abre aquí mismo. En bolívares, coordinamos por WhatsApp a la tasa del día.'
          : 'El pago con tarjeta se abre aquí mismo y el archivo te llega al correo al momento.'
    }
  </p>
</div>

{
  wa && (
    <script is:inline>
      (() => {
        const btn = document.querySelector('[data-bs-toggle]');
        const panel = document.getElementById('bs-panel');
        if (!btn || !panel) return;
        btn.addEventListener('click', () => {
          const open = panel.hasAttribute('hidden');
          panel.toggleAttribute('hidden', !open);
          btn.setAttribute('aria-expanded', String(open));
        });
      })();
    </script>
  )
}

<style>
  .buy {
    padding: 22px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .price {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .amount {
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .currency {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .actions .btn {
    flex: 1 1 200px;
  }
  /* Gumroad mete un <span class="logo-full"></span> vacío dentro del botón al abrir el modal:
     suma 8 px de hueco a la derecha del texto. Se oculta (no lleva el atributo de estilo propio). */
  .actions :global(.logo-full) {
    display: none;
  }
  .bs-panel {
    padding: 16px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .bs-panel[hidden] {
    display: none;
  }
  .bs-title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--ink);
  }
  .bs-text {
    font-size: 0.9375rem;
    color: var(--ink-2);
  }
  .bs-wa {
    align-self: flex-start;
    min-height: 44px;
    padding: 0 20px;
    font-size: 0.9375rem;
  }
  .note {
    font-size: 0.9375rem;
    color: var(--muted);
  }
</style>
