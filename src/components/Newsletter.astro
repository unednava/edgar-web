---
import { site } from '../data/site';
import Icon from './Icon.astro';

const action = site.newsletterAction;
---

<section id="newsletter" class="wrap section newsletter">
  <div class="box card">
    <span class="icon" aria-hidden="true"><Icon name="mail" size={26} /></span>
    <h2 class="section-title">Un experimento nuevo cada semana, en tu correo.</h2>
    <p class="lead">Lo que probé, cuánto costó y qué funcionó. Más las plantillas de cada video, gratis.</p>

    <form class="form" method="post" action={action || undefined} target="_blank">
      <label for="email" class="sr-only">Tu correo electrónico</label>
      <input id="email" name="email" type="email" required placeholder="tu@correo.com" autocomplete="email" />
      <button type="submit" class="btn btn-primary" disabled={!action}>Suscribirme</button>
    </form>
    <p class="note">{action ? 'Sin spam. Te das de baja cuando quieras.' : 'La newsletter abre pronto.'}</p>
  </div>
</section>

<style>
  .newsletter {
    padding-top: 0;
  }
  .box {
    padding: clamp(40px, 6vw, 64px) clamp(24px, 5vw, 48px);
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: center;
    text-align: center;
    box-shadow: var(--shadow-lg);
  }
  .icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 18px;
    background: var(--accent-soft);
    color: var(--accent);
    margin-bottom: 4px;
  }
  .section-title {
    max-width: 18ch;
    text-wrap: balance;
  }
  .lead {
    max-width: 46ch;
  }
  .form {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    width: 100%;
    max-width: 520px;
    margin-top: 12px;
  }
  input {
    flex: 1 1 260px;
    min-width: 0;
    min-height: 52px;
    background: var(--surface);
    border: 1px solid var(--field-border);
    color: var(--ink);
    border-radius: 999px;
    padding: 0 22px;
    font: 400 1rem var(--font);
  }
  input::placeholder {
    color: var(--muted);
    opacity: 1;
  }
  button:disabled {
    opacity: 0.55;
    cursor: not-allowed;
    box-shadow: none;
  }
  button:disabled:active {
    transform: none;
  }
  .note {
    font-size: 0.9375rem;
    color: var(--muted);
  }
</style>
