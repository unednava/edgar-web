---
import { site, heroExample as ex } from '../data/site';
import Icon from './Icon.astro';
---

<section class="wrap hero">
  <div class="copy">
    <p class="kicker pill"><span class="live" aria-hidden="true"></span>{site.kicker}</p>
    <h1>{site.headline}</h1>
    <p class="intro">{site.intro}</p>
    <div class="ctas">
      <a href="#newsletter" class="btn btn-primary">Suscribirme gratis</a>
      <a href="#aprende" class="btn btn-ghost">Ver qué aprendes</a>
    </div>
  </div>

  <figure class="demo card" aria-label="Ejemplo: cómo la IA cuida una campaña cuando sube el costo">
    <div class="alert">
      <p class="campaign">{ex.campaign}</p>
      <p class="cost-label">Costo por cliente</p>
      <p class="cost">
        <span class="before">{ex.costBefore}</span>
        <Icon name="arrow" size={18} />
        <span class="after">{ex.costAfter}</span>
        <span class="badge">Subió</span>
      </p>
    </div>

    <ol class="steps">
      {
        ex.steps.map((s, i) => (
          <li class="step" style={`--i:${i}`}>
            <span class="tick" aria-hidden="true">
              <Icon name="check" size={16} />
            </span>
            <span>
              <strong>{s.title}</strong>
              <span class="step-text">{s.text}</span>
            </span>
          </li>
        ))
      }
    </ol>

    <figcaption class="note">{ex.footnote}</figcaption>
  </figure>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(40px, 6vw, 72px);
    align-items: center;
    padding-block: clamp(48px, 8vw, 96px) clamp(56px, 8vw, 96px);
  }
  .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    min-width: 0;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 10px;
    border-radius: 999px;
    background: var(--accent-soft);
  }
  .live {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 22%, transparent);
  }
  h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
    font-weight: 800;
    text-wrap: balance;
  }
  .intro {
    font-size: clamp(1.125rem, 1.6vw, 1.25rem);
    color: var(--ink-2);
    max-width: 34ch;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 4px;
  }

  /* Tarjeta de ejemplo */
  .demo {
    margin: 0;
    padding: 8px;
    box-shadow: var(--shadow-lg);
    min-width: 0;
  }
  .alert {
    background: var(--warn-soft);
    border-radius: 14px;
    padding: 20px 22px;
  }
  .campaign {
    font-size: 0.875rem;
    color: var(--ink-2);
    font-weight: 500;
  }
  .cost-label {
    margin-top: 14px;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .cost {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    color: var(--ink-2);
  }
  .before {
    font-size: 1.25rem;
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }
  .after {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--warn);
  }
  .badge {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--warn);
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 2px 10px;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 18px 16px 6px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .step {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    font-size: 1rem;
    line-height: 1.45;
    opacity: 0;
    transform: translateY(6px);
    animation: appear 560ms var(--ease-out) forwards;
    animation-delay: calc(500ms + var(--i) * 700ms);
  }
  .step strong {
    display: block;
    font-weight: 600;
  }
  .step-text {
    color: var(--ink-2);
  }
  .tick {
    flex: none;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    margin-top: 1px;
  }
  .note {
    margin: 10px 8px 4px;
    padding: 14px 14px 10px;
    border-top: 1px solid var(--line);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--accent);
  }
  @keyframes appear {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 880px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .intro {
      max-width: none;
    }
  }
</style>
