---
import { site, heroExample as ex, primaryCta as cta } from '../data/site';
import Icon from './Icon.astro';

/*
  Gráfica animada (SVG, sin librerías). Tres tramos de línea:
  A) los clientes suben y luego bajan  → punto 1
  B) la IA pausa el anuncio cansado     → punto 2
  C) la campaña se recupera             → punto 3
  Cada paso de la lista se ilumina cuando la línea llega a su punto.
  Tiempos en --t1, --t2, --t3 (segundos desde que empieza).
*/
// El punto final del titular va aparte: en esta tipografía queda separado de la palabra.
const headlineText = site.headline.replace(/\.$/, '');
const headlineDot = site.headline.endsWith('.');
// Palabra con tira amarilla de collage (site.headlineHighlight).
const hlAt = headlineText.lastIndexOf(site.headlineHighlight);
const hlBefore = hlAt >= 0 ? headlineText.slice(0, hlAt) : headlineText;
const hlWord = hlAt >= 0 ? site.headlineHighlight : '';
const hlAfter = hlAt >= 0 ? headlineText.slice(hlAt + hlWord.length) : '';

const marks = [
  { x: 150, y: 104, tone: 'warn' },
  { x: 190, y: 98, tone: 'accent' },
  { x: 308, y: 26, tone: 'accent' },
];
---

<section class="wrap hero">
  <div class="copy">
    <p class="greeting">
      <!-- Cuando tengas una foto, cámbiala aquí por <img src="/edgar.jpg" alt="" class="face photo" />. -->
      <img class="face" src="/brand/llama.webp" alt="" width="34" height="40" />
      {site.greeting}
    </p>
    <h1>
      {hlBefore}{hlWord && <span class="hl">{hlWord}</span>}{hlAfter}{headlineDot && <span class="dot">.</span>}
    </h1>
    <p class="intro">{site.intro}</p>
    <div class="ctas">
      <a href={cta.href} class="btn btn-primary" {...cta.external ? { target: '_blank', rel: 'noopener' } : {}}>
        {cta.label}
      </a>
      <a href="#aprende" class="btn btn-ghost">De qué hablo</a>
    </div>
  </div>

  <div class="demo-wrap">
  <img
    class="cutout bulb"
    src="/collage/bombilla-estrellas.webp"
    alt=""
    width="480"
    height="362"
    style="--rot: 9deg"
    decoding="async"
  />
  <figure class="demo card play" id="demo" aria-labelledby="demo-title">
    <div class="demo-head">
      <p class="demo-title" id="demo-title">
        {ex.title} <span class="tag">{ex.tag}</span>
      </p>
      <button type="button" class="replay" id="demo-replay" aria-label="Ver la animación de nuevo">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 12a9 9 0 1 0 3-6.7L3 8 M3 3v5h5"></path>
        </svg>
      </button>
    </div>

    <div class="chart">
      <p class="chart-label">{ex.chartLabel}</p>
      <svg viewBox="0 0 320 140" role="img" aria-label="Gráfica: los clientes bajan, la IA actúa y la campaña se recupera.">
        <defs>
          <linearGradient id="area" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="var(--hl)" stop-opacity="0.55"></stop>
            <stop offset="100%" stop-color="var(--hl)" stop-opacity="0"></stop>
          </linearGradient>
        </defs>
        <g class="grid">
          <line x1="0" y1="30" x2="320" y2="30"></line>
          <line x1="0" y1="70" x2="320" y2="70"></line>
          <line x1="0" y1="110" x2="320" y2="110"></line>
        </g>
        <path class="area" d="M190 98 C230 92 250 60 272 46 S300 30 308 26 L308 140 L190 140 Z" fill="url(#area)"></path>
        <path class="seg seg-a" pathLength="1" d="M12 92 C40 84 62 58 92 56 S130 92 150 104"></path>
        <path class="seg seg-b" pathLength="1" d="M150 104 C162 110 176 104 190 98"></path>
        <path class="seg seg-c" pathLength="1" d="M190 98 C230 92 250 60 272 46 S300 30 308 26"></path>
        {
          marks.map((m, i) => (
            <g class={`mark mark-${i + 1} ${m.tone}`}>
              <circle class="halo" cx={m.x} cy={m.y} r="11"></circle>
              <circle class="dot" cx={m.x} cy={m.y} r="8"></circle>
              <text x={m.x} y={m.y + 3.5} text-anchor="middle">
                {i + 1}
              </text>
            </g>
          ))
        }
      </svg>
    </div>

    <ol class="steps">
      {
        ex.steps.map((s, i) => (
          <li class={`step step-${i + 1}`}>
            <span class="num" aria-hidden="true">
              {i + 1}
            </span>
            <span>
              <strong>{s.title}</strong>
              <span class="step-text">{s.text}</span>
            </span>
          </li>
        ))
      }
    </ol>

    <figcaption class="note">
      <Icon name="check" size={18} />
      {ex.footnote}
    </figcaption>
  </figure>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(40px, 6vw, 72px);
    align-items: center;
    padding-block: clamp(48px, 8vw, 96px) clamp(56px, 8vw, 96px);
  }
  .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    min-width: 0;
  }
  .greeting {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--ink-2);
  }
  .face {
    display: block;
    width: 34px;
    height: 40px;
  }
  .face.photo {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
  }
  .dot {
    margin-left: -0.08em;
  }
  h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
    font-weight: 800;
    text-wrap: balance;
  }
  .intro {
    font-size: clamp(1.125rem, 1.6vw, 1.25rem);
    color: var(--ink-2);
    max-width: 34ch;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 4px;
  }

  /* ---------- Tarjeta animada ---------- */
  /* Recorte de collage asomando por detrás de la tarjeta */
  .demo-wrap {
    position: relative;
    min-width: 0;
    margin-top: 72px; /* deja sitio a la bombilla sin que choque con el encabezado */
  }
  .bulb {
    position: absolute;
    z-index: 0;
    top: -128px;
    right: -36px;
    width: 230px;
  }
  .demo-wrap .demo {
    position: relative;
    z-index: 1;
  }
  .demo {
    --t1: 1.8s; /* punto 1: algo deja de funcionar */
    --t2: 3.1s; /* punto 2: la IA pausa */
    --t3: 5.1s; /* punto 3: te llega el resumen */
    margin: 0;
    padding: 22px 22px 8px;
    box-shadow: var(--shadow-lg);
    min-width: 0;
  }
  .demo-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .demo-title {
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }
  .tag {
    margin-left: 6px;
    padding: 2px 8px;
    border: 1px solid var(--line);
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--muted);
    vertical-align: 2px;
  }
  .replay {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink-2);
    cursor: pointer;
    transition: transform 160ms var(--ease-out);
  }
  .replay:hover {
    color: var(--ink);
  }
  .replay:active {
    transform: scale(0.92) rotate(-30deg);
  }
  .chart {
    margin-top: 14px;
    padding: 14px 14px 6px;
    border-radius: 14px;
    background: var(--bg);
  }
  .chart-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--muted);
  }
  .chart svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .grid line {
    stroke: var(--line);
    stroke-width: 1;
  }
  .seg {
    fill: none;
    stroke-width: 3.5;
    stroke-linecap: round;
    /* hueco (2) mayor que la línea (1): no queda ningún remate suelto antes de dibujarse */
    stroke-dasharray: 1 2;
    stroke-dashoffset: 0;
  }
  .seg-a {
    stroke: var(--muted);
  }
  .seg-b {
    stroke: var(--accent);
    stroke-dasharray: 0.08 0.08;
  }
  .seg-c {
    stroke: var(--accent);
  }
  .mark .dot {
    stroke: var(--surface);
    stroke-width: 2;
  }
  .mark .halo {
    opacity: 0.2;
  }
  .mark.warn .dot,
  .mark.warn .halo {
    fill: var(--warn);
  }
  .mark.accent .dot,
  .mark.accent .halo {
    fill: var(--accent);
  }
  .mark text {
    font: 700 9px var(--font);
    fill: var(--surface);
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 18px 4px 6px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .step {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    font-size: 1rem;
    line-height: 1.45;
  }
  .step strong {
    display: block;
    font-weight: 600;
  }
  .step-text {
    color: var(--ink-2);
  }
  .num {
    flex: none;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    font-size: 0.8125rem;
    font-weight: 700;
    background: var(--accent-soft);
    color: var(--accent);
    margin-top: 1px;
  }
  .step-1 .num {
    background: var(--warn-soft);
    color: var(--warn);
  }
  .note {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 10px -22px 0;
    padding: 14px 22px;
    border-top: 1px solid var(--line);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--accent);
  }

  /* ---------- Animación (se reinicia al quitar y poner .play) ---------- */
  .play .seg {
    stroke-dashoffset: 1;
    animation: draw var(--dur) var(--ease-out) var(--at) forwards;
  }
  .play .seg-a {
    --at: 0.4s;
    --dur: 1.4s;
  }
  .play .seg-b {
    /* tramo punteado: aparece en vez de dibujarse */
    stroke-dashoffset: 0;
    opacity: 0;
    animation: fade 500ms ease var(--at) forwards;
    --at: 2.6s;
  }
  .play .seg-c {
    --at: 3.9s;
    --dur: 1.2s;
  }
  .play .area {
    opacity: 0;
    animation: fade 900ms ease 4.5s forwards;
  }
  .play .mark {
    opacity: 0;
    transform: scale(0.4);
    transform-box: fill-box;
    transform-origin: center;
    animation: pop 420ms cubic-bezier(0.34, 1.4, 0.64, 1) var(--at) forwards;
  }
  .play .mark-1,
  .play .step-1 {
    --at: var(--t1);
  }
  .play .mark-2,
  .play .step-2 {
    --at: var(--t2);
  }
  .play .mark-3,
  .play .step-3 {
    --at: var(--t3);
  }
  /* Los pasos están siempre visibles (atenuados) y se encienden a su tiempo */
  .play .step {
    opacity: 0.35;
    animation: light 500ms ease var(--at) forwards;
  }
  .play .note {
    opacity: 0.35;
    animation: light 500ms ease calc(var(--t3) + 0.5s) forwards;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes fade {
    to {
      opacity: 1;
    }
  }
  @keyframes pop {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes light {
    to {
      opacity: 1;
    }
  }

  @media (max-width: 880px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .demo-wrap {
      margin-top: 40px;
    }
    .bulb {
      width: 150px;
      top: -64px;
      right: -8px;
    }
    .intro {
      max-width: none;
    }
  }
</style>

<script>
  const demo = document.getElementById('demo');
  document.getElementById('demo-replay')?.addEventListener('click', () => {
    if (!demo) return;
    demo.classList.remove('play');
    void demo.offsetWidth; // reinicia las animaciones
    demo.classList.add('play');
  });
</script>
